# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# Base de datos. Si se omite, usa SQLite local (./renal.db).
# Producción (Neon/PostgreSQL): postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=

# true = si la BD está vacía al arrancar, carga los 144 pacientes FICTICIOS de seed.py
# y muestra el banner "Demo con datos ficticios" y el botón "Ver demo".
DEMO_MODE=false

# Login. Si se dejan vacíos, el login se desactiva (solo para desarrollo local).
APP_USER=
APP_PASSWORD=

# Firma de la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# true en producción (HTTPS): la cookie solo viaja cifrada.
COOKIE_SECURE=false

# Clave de la API de Anthropic. Opcional: sin ella el módulo de IA se oculta.
ANTHROPIC_API_KEY=

# Integración HL7 con las máquinas AK 98 («Próximamente», ver docs/integracion-hl7.md).
# false = INACTIVA: los endpoints /api/hl7/* de ingesta responden 404 y solo se ve
# la burbuja informativa. No activar sin autorización de la unidad y del fabricante.
HL7_ENABLED=false
# Secreto compartido con el puente local (firma HMAC). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HL7_BRIDGE_SECRET=
# Tolerancia en segundos del sello de tiempo de la firma (anti-repetición).
HL7_VENTANA_SEGUNDOS=300
