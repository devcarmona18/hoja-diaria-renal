# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# Base de datos. Si se omite, usa SQLite local (./renal.db).
# Producción (Neon/PostgreSQL): postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=

# true = si la BD está vacía al arrancar, carga los 144 pacientes FICTICIOS de seed.py
# y muestra el banner "Demo con datos ficticios" y el botón "Ver demo".
DEMO_MODE=false

# Login. Si se dejan vacíos, el login se desactiva (solo para desarrollo local).
APP_USER=
APP_PASSWORD=

# Firma de la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# true en producción (HTTPS): la cookie solo viaja cifrada.
COOKIE_SECURE=false

# ── R9: apartado «IA» = NefroIA integrado (ver docs/integracion-nefroia.md) ───
# Sin estas dos variables el apartado muestra «NefroIA no está configurado
# todavía» y no se hace ninguna llamada. Nunca se envían datos de pacientes.
# URL pública de NefroIA, sin barra final. Ej.: https://nefroia.onrender.com
NEFROIA_URL=
# Secreto compartido con NefroIA (mismo valor en ambos, ≥ 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NEFROIA_SSO_SECRET=
# Vida del token de acceso en segundos (máximo 120).
NEFROIA_TOKEN_TTL=60

# Integración HL7 con las máquinas AK 98 («Próximamente», ver docs/integracion-hl7.md).
# false = INACTIVA: los endpoints /api/hl7/* de ingesta responden 404 y solo se ve
# la burbuja informativa. No activar sin autorización de la unidad y del fabricante.
HL7_ENABLED=false
# Secreto compartido con el puente local (firma HMAC). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HL7_BRIDGE_SECRET=
# Tolerancia en segundos del sello de tiempo de la firma (anti-repetición).
HL7_VENTANA_SEGUNDOS=300

# ── Laboratorios / archivo de pacientes (R13) ─────────────────────────────────
# Días que un paciente archivado sigue en la lista «Archivados» y se puede restaurar.
# Sus sesiones, laboratorios y asistencia NUNCA se borran.
ARCHIVO_DIAS=180
# Notificación por Microsoft Teams (webhook por médico). APAGADA: con false no sale
# ninguna llamada HTTP. Actívala solo con autorización de la unidad.
TEAMS_ENABLED=false
# Días del mes en que se envía el reporte (separados por coma).
TEAMS_DIAS=1,15
# Token del trabajo programado de GitHub Actions (Authorization: Bearer ...).
TEAMS_JOB_TOKEN=
